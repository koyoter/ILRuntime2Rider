<idea-plugin require-restart="true">
    <id>com.jetbrains.rider.plugins.ilruntime2rider</id>
    <name>ILRuntime2Rider</name>
    <version>_PLACEHOLDER_</version>
    <vendor url="https://project-url">Author</vendor>
    <idea-version since-build="243" until-build="243.*"/>
    <depends>com.intellij.modules.rider</depends>
    <depends>com.intellij.modules.xdebugger</depends>
    <depends>rider.intellij.plugin.appender</depends>

    <description>
        <![CDATA[
<p>Attach Rider's debugger to Unity games running ILRuntime hot-update DLLs, with breakpoint, stepping and variable inspection support.</p>
]]>
    </description>

    <project-components>
        <component>
            <implementation-class>com.jetbrains.rider.plugins.ilruntime2rider.run.DefaultRunConfigurationGenerator
            </implementation-class>
        </component>
    </project-components>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="ILRuntime2Rider.Notifications" displayType="BALLOON"/>
        <configurationType
                implementation="com.jetbrains.rider.plugins.ilruntime2rider.run.attach.ILRuntimeAttachRunConfigurationType"/>
    </extensions>
</idea-plugin>
